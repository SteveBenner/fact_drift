parameters:
  level: 6
  fileExtensions:
    - php
    - module
    - install
  paths:
    - src
    - fact_drift.module
    - fact_drift.install
    - tests
    - modules
  ignoreErrors:
    -
      message: '#Attribute class Drupal\\Core\\Hook\\Attribute\\(Hook|LegacyHook) does not exist#'
      reportUnmatched: false
  reportUnmatchedIgnoredErrors: false
